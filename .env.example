# Community game configuration. Do not copy production secrets here.
PORT=3200
BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:3200
DEMO_MODE=1
DB_PATH=./data/city.sqlite
ROUND_SECONDS=120
TRUST_PROXY=0
# Optional server-side narration; no key is needed to play.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_MAX_DAILY_CALLS=20
AI_ALLOW_DEMO=0

# Optional integrations. Leave empty/disabled for local guest play.
BSC_RPC_URL=https://bsc-dataseed.binance.org/
GAME_TOKEN_ADDRESS=
GAME_TOKEN_DECIMALS=18
REWARD_TREASURY_ADDRESS=
REWARD_AUTO_ENABLED=0
REWARD_PERIOD_SECONDS=60
REWARD_FROM_BLOCK=
REWARD_MANIFEST_DIR=
REWARD_PUBLISHER_PRIVATE_KEY=
ENERGY_ENABLED=0
ENERGY_TRANSFER_TAX_BPS=0
STUDIO_ENABLED=0
STUDIO_PAYMENT_ADDRESS=
STUDIO_TRANSFER_TAX_BPS=0
STUDIO_DAILY_USD=3
PIAPI_API_KEY=
HF_CREDENTIALS=
